{
  "expo": {
    "name": "MASKPROCare",
    "slug": "maskpro-care",
    "version": "1.13.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.maskpro.care",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "MASKPRO Care requires access to your camera to take photos for your profile avatar and vehicle service documentation.",
        "NSPhotoLibraryUsageDescription": "MASKPRO Care requires access to your photo library to select photos for your profile avatar and vehicle documentation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "ph.maskpro.care",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MASKPRO Care requires access to your photo library to select photos for your profile avatar and vehicle documentation.",
          "cameraPermission": "MASKPRO Care requires access to your camera to take photos for your profile avatar and vehicle service documentation.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
